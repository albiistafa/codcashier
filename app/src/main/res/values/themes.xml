<resources>
    <!-- Framework theme: the UI is all Compose, so no AppCompat/Material Components library is needed.
         The system splash is plain leaf green so only the Compose struk animation plays -->
    <style name="Theme.Kasirku" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/leaf_hero</item>
        <item name="android:windowBackground">@color/leaf_hero</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
